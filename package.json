{
  "name": "ediary-plus",
  "version": "0.2.17",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs",
    "pack": "npm run build && electron-builder --config electron-builder.config.cjs",
    "pack:mac": "npm run build && electron-builder --mac --config electron-builder.config.cjs",
    "pack:win": "npm run build && electron-builder --win --config electron-builder.config.cjs",
    "icons": "node scripts/icons.mjs",
    "pack:dir": "npm run build && electron-builder --dir --config electron-builder.config.cjs",
    "test:desktop": "node scripts/test-electron.cjs"
  },
  "dependencies": {
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/markdown": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "lucide": "^0.468.0",
    "marked": "^17.0.6"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "sharp": "^0.35.5",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "local.ediary.plus",
    "productName": "拾日匣",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.lifestyle",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "extraResources": [
      {
        "from": "public/manual.html",
        "to": "使用说明书.html"
      },
      {
        "from": "public/licenses",
        "to": "licenses"
      }
    ]
  },
  "description": "拾日匣 · 本地日记本，记录日常，收藏岁月",
  "author": "拾日匣"
}
